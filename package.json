{
  "name": "biome-intellij-issue-233-repro",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal Fastify + Biome 2.4.9 setup to reproduce biome-intellij issue #233",
  "scripts": {
    "start": "node src/server.js",
